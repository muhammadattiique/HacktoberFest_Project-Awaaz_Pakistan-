# Awaaz Pakistan Configuration Environment File
APP_NAME="Awaaz Pakistan"
ENVIRONMENT="development"
DEBUG=true
API_PREFIX="/api"

# AI Pipeline
WHISPER_MODEL="base"
WHISPER_DEVICE="cpu"
OLLAMA_MODEL="qwen2.5:1.5b-instruct"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_TIMEOUT=30.0

# Audio Constraints
UPLOAD_MAX_BYTES=26214400
AUDIO_MIN_DURATION_SECONDS=0.5
AUDIO_MAX_DURATION_SECONDS=120.0

# Database
DATABASE_URL="sqlite+aiosqlite:///./awaaz.db"

# Reference rate list path
RATE_LIST_PATH="./rate-list.json"

# CORS
CORS_ORIGINS="*"

# Administrative portal security.
# This is the shared secret the React admin portal sends in the `X-API-Key`
# header. The value below is the documented DEMO key - replace it with a long
# random string before any real deployment.
AWAAZ_ADMIN_API_KEY="awaaz-admin-2024"

# Official Helplines (VERIFY BEFORE PRODUCTION)
DISTRICT_HELPLINE_ICT="051-9108194"
DISTRICT_HELPLINE_RAWALPINDI="051-9292514"
PERA_ENFORCEMENT_HELPLINE="1717"
PFA_FOOD_SAFETY_HELPLINE="1223"
CDA_MUNICIPAL_HELPLINE="1819"
WASA_RAWALPINDI_HELPLINE="1334"
LEGAL_FINE_MIN_PKR=5000
LEGAL_FINE_MAX_PKR=100000

